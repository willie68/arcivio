meta {
  name: GET openid-configuration
  type: http
  seq: 1
  tags: [
    auth
    https
  ]
}

get {
  url: {{httpsUrl}}/auth/.well-known/openid-configuration
  body: none
  auth: inherit
}

tests {
  test("discovery is 200", function () {
    expect(res.status).to.equal(200);
  });

  test("supports PKCE S256", function () {
    expect(res.body.code_challenge_methods_supported).to.include("S256");
    expect(res.body.response_types_supported).to.include("code");
  });
}
